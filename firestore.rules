rules_version = '2';
// 记账本规则。程序更新后，请把本文件全部内容粘贴到
// Firebase 控制台 → Firestore Database → Rules → Publish（发布）。
// users/{uid} 只有本人能读写，用来记住昵称、头像、主题和语言。
// 其他成员看到的名字和头像写在账本的 memberInfo 里，不对外公开。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasEmail() {
      return request.auth.token.email is string && request.auth.token.email.size() > 0;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function wsPath(wsId) { return /databases/$(database)/documents/workspaces/$(wsId); }
    // get() only sees data already saved. A brand-new workspace is invisible to get()
    // in the same batch that creates it, so starter categories must also check getAfter().
    function isMemberOf(wsId) {
      return signedIn() && exists(wsPath(wsId)) && request.auth.uid in get(wsPath(wsId)).data.members;
    }
    function isMemberAfter(wsId) {
      return signedIn() && existsAfter(wsPath(wsId)) && request.auth.uid in getAfter(wsPath(wsId)).data.members;
    }
    function addedMembers() {
      return request.resource.data.members.toSet().difference(resource.data.members.toSet());
    }
    function removedMembers() {
      return resource.data.members.toSet().difference(request.resource.data.members.toSet());
    }
    function memberInfoKeysChanged() {
      return request.resource.data.get('memberInfo', {}).diff(resource.data.get('memberInfo', {})).affectedKeys();
    }
    function validAvatar(a) {
      return a is string && (
        a == "" ||
        (a.size() <= 32 && a.matches('emoji:.+')) ||
        (a.size() <= 80000 && (
          a.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+') ||
          a.matches('data:image/png;base64,[A-Za-z0-9+/=]+')
        ))
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'theme', 'lang'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && validAvatar(request.resource.data.avatar)
        && request.resource.data.theme in ['fresh', 'warm', 'dark']
        && request.resource.data.lang in ['zh', 'en'];
      allow delete: if false;
    }

    match /workspaces/{wsId} {
      // Two separate reads so a "my workspaces" query and an "invites for my email"
      // query each match one rule. Email is only read when the account has one.
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow read: if signedIn() && hasEmail() && myEmail() in resource.data.invitedEmails;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Members can edit the workspace (name, currency, budget, invites…), but:
      // - nobody can change the owner or add members directly (people join by accepting an invite);
      // - the owner can remove other members, but not themself;
      // - everyone else can only remove themself (leave), and only edit their own memberInfo.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members is list
          && addedMembers().size() == 0
          && (
            (request.auth.uid == resource.data.ownerUid
              && request.auth.uid in request.resource.data.members
              && memberInfoKeysChanged().difference(removedMembers()).hasOnly([request.auth.uid]))
            ||
            (request.auth.uid != resource.data.ownerUid
              && removedMembers().hasOnly([request.auth.uid])
              && memberInfoKeysChanged().hasOnly([request.auth.uid]))
          ))
        ||
        (hasEmail() && myEmail() in resource.data.invitedEmails
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'invitedEmails'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0
          && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid])
          && resource.data.invitedEmails.toSet().difference(request.resource.data.invitedEmails.toSet()).hasOnly([myEmail()])
          && request.resource.data.invitedEmails.toSet().difference(resource.data.invitedEmails.toSet()).size() == 0)
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Subcollections only. "{coll}/{rest=**}" needs at least one segment below the
      // workspace. The old "{sub=**}" also matched the workspace document itself, so its
      // isMemberAfter() check let anyone add themself as a member.
      match /{coll}/{rest=**} {
        allow read: if isMemberOf(wsId);
        allow create, update, delete: if isMemberOf(wsId) || isMemberAfter(wsId);
      }
    }
  }
}
